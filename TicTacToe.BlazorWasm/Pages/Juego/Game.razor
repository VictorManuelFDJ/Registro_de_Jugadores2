@page "/game/{jugador1Id:int}/{jugador2Id:int}"
@page "/game/{PartidaId:int}"

@inject IJugadoreApiService jugadoresService
@inject IPartidasApiService partidaService
@inject IMovimientoApiService movimientoApiService
@inject NavigationManager navigationManager
@inject IJSRuntime JSRuntime

@implements IDisposable

<PageTitle>Juego</PageTitle>

<div class="container mx-auto max-w-lg p-6 bg-white rounded-lg shadow-xl text-center">
    <div class="game-container">
        <h2 class="game-status">@GameStatus</h2>
        <div class="game-screen">
            <div class="game-board">
                @for (var i = 0; i < 9; i++)
                {
                    var cellIndex = i;
                    <button class="cell @GetPlayerClass(board[cellIndex])"
                            @onclick="() => HandleCellClick(cellIndex)"
                            disabled="@(board[cellIndex] != null || winner != null || esEmpate)">
                        @board[cellIndex]?.ToString()
                    </button>
                }
            </div>
            <button class="btn btn-secondary mt-4" @onclick="RestartGame">
                Reiniciar Juego
            </button>
        </div>
    </div>
</div>

@code {
    private enum PlayerType { X, O }

    private PlayerType?[] board = new PlayerType?[9];
    private PlayerType _currentPlayerType = PlayerType.X;
    private PlayerType? winner;
    private bool esEmpate;

    [Parameter] public int? jugador1Id { get; set; }
    [Parameter] public int? jugador2Id { get; set; }
    [Parameter] public int? PartidaId { get; set; }

    private string nombreJugador1;
    private string nombreJugador2;
    private Dictionary<int, PlayerType> jugadorIdToPlayerType = new Dictionary<int, PlayerType>();
    private Dictionary<PlayerType, string> playerTypeToNombre = new Dictionary<PlayerType, string>();

    private class Partidas
    {
        public int PartidaId { get; set; }
        public int Jugador1Id { get; set; }
        public int Jugador2Id { get; set; }
        public string? EstadoPartida { get; set; }
        public string? EstadoTablero { get; set; }
        public int TurnoJugadorId { get; set; }
        public DateTime FechaInicio { get; set; }
        public int? GanadorId { get; set; }
        public DateTime? FechaFin { get; set; }
    }

    private Partidas partidaActual = new Partidas();
    private JugadorResponse jugador1Global = new JugadorResponse(0, "", "");
    private JugadorResponse jugador2Global = new JugadorResponse(0, "", "");

    private System.Timers.Timer _timer;
    private int _movimientosContados = 0;

    protected override async Task OnInitializedAsync()
    {
        _timer = new System.Timers.Timer(3000);
        _timer.Elapsed += async (sender, e) => await CargarTableroAsync();
        _timer.AutoReset = true;
        _timer.Start();
    }

    protected override async Task OnParametersSetAsync()
    {
        bool isNewGame = false;

        if (PartidaId.HasValue)
        {
            var partidaResource = await partidaService.GetPartidaAsync(PartidaId.Value);
            if (partidaResource is Resource<PartidaResponse>.Error) return;
            var partidaDto = (partidaResource as Resource<PartidaResponse>.Success).Data;
            partidaActual.PartidaId = partidaDto.PartidaId;
            partidaActual.Jugador1Id = partidaDto.Jugador1Id;
            partidaActual.Jugador2Id = partidaDto.Jugador2Id;
        }
        else if (jugador1Id.HasValue && jugador2Id.HasValue)
        {
            var partidaResource = await partidaService.PostPartida(jugador1Id.Value, jugador2Id.Value);
            if (partidaResource is Resource<PartidaResponse>.Error) return;
            var partidaDto = (partidaResource as Resource<PartidaResponse>.Success).Data;

            partidaActual = new Partidas
            {
                PartidaId = partidaDto.PartidaId,
                Jugador1Id = partidaDto.Jugador1Id,
                Jugador2Id = partidaDto.Jugador2Id,
                EstadoPartida = "En Proceso",
                EstadoTablero = "---------",
                TurnoJugadorId = jugador1Id.Value,
                FechaInicio = DateTime.UtcNow
            };
            isNewGame = true;
        }
        else
        {
            return;
        }

        var j1Resource = await jugadoresService.GetJugadorAsync(partidaActual.Jugador1Id);
        var j2Resource = await jugadoresService.GetJugadorAsync(partidaActual.Jugador2Id);

        if (j1Resource is Resource<JugadorResponse>.Success s1 && j2Resource is Resource<JugadorResponse>.Success s2)
        {
            jugador1Global = s1.Data;
            jugador2Global = s2.Data;
            nombreJugador1 = jugador1Global.Nombres;
            nombreJugador2 = jugador2Global.Nombres;
            jugadorIdToPlayerType[jugador1Global.JugadorId] = PlayerType.X;
            jugadorIdToPlayerType[jugador2Global.JugadorId] = PlayerType.O;
            playerTypeToNombre[PlayerType.X] = nombreJugador1;
            playerTypeToNombre[PlayerType.O] = nombreJugador2;
        }
        else return;

        await CargarTableroAsync();

        if (isNewGame)
        {
            navigationManager.NavigateTo($"/game/{partidaActual.PartidaId}", replace: true);
        }
    }

    private async Task CargarTableroAsync()
    {
        if (partidaActual.PartidaId == 0) return;

        var movimientosResource = await movimientoApiService.GetMovimientosAsync(partidaActual.PartidaId);
        if (movimientosResource is Resource<List<MovimientoResponse>>.Success success)
        {
            var movimientos = success.Data;

            if (movimientos.Count == _movimientosContados)
            {
                return;
            }
            _movimientosContados = movimientos.Count;

            ReconstruirTablero(movimientos);

            winner = CheckForWinner();
            if (winner != null)
            {
                _timer.Stop();
                partidaActual.GanadorId = winner == PlayerType.X ? partidaActual.Jugador1Id : partidaActual.Jugador2Id;
                partidaActual.EstadoPartida = "Finalizada";
            }
            else
            {
                esEmpate = board.All(cell => cell != null);
                if (esEmpate)
                {
                    _timer.Stop();
                    partidaActual.EstadoPartida = "Empate";
                }
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private void ReconstruirTablero(List<MovimientoResponse> movimientos)
    {
        board = new PlayerType?[9];

        foreach (var mov in movimientos)
        {
            int index = (mov.PosicionFila * 3) + mov.PosicionColumna;
            var playerType = (mov.Jugador == "X") ? PlayerType.X : PlayerType.O;
            board[index] = playerType;
        }

        _currentPlayerType = (movimientos.Count % 2 == 0) ? PlayerType.X : PlayerType.O;
    }


    private string GameStatus
    {
        get
        {
            if (winner != null)
            {
                var nombreGanador = winner == PlayerType.X ? nombreJugador1 : nombreJugador2;
                return $"🏆 ¡Ganador: {nombreGanador}!";
            }
            return esEmpate
                ? "🤝 ¡Es un empate!"
                : $"Turno de: {(playerTypeToNombre.ContainsKey(_currentPlayerType) ? playerTypeToNombre[_currentPlayerType] : "")}";
        }
    }

    private async Task HandleCellClick(int index)
    {
        if (board[index] != null || winner != null || esEmpate)
        {
            return;
        }

        int fila = index / 3;
        int columna = index % 3;

        string jugadorString = _currentPlayerType.ToString();

        var postResource = await movimientoApiService.PostMovimientos(
            partidaActual.PartidaId,
            jugadorString,
            fila,
            columna
        );

        if (postResource is Resource<MovimientoResponse>.Success)
        {
            await CargarTableroAsync();
        }
        else if (postResource is Resource<MovimientoResponse>.Error error)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al hacer movimiento: {error.Message}");
        }
    }

    private PlayerType? CheckForWinner()
    {
        var winningLines = new[]
        {
            new[] {0, 1, 2}, new[] {3, 4, 5}, new[] {6, 7, 8},
            new[] {0, 3, 6}, new[] {1, 4, 7}, new[] {2, 5, 8},
            new[] {0, 4, 8}, new[] {2, 4, 6}
        };
        foreach (var line in winningLines)
        {
            var (a, b, c) = (line[0], line[1], line[2]);
            if (board[a].HasValue && board[a] == board[b] && board[a] == board[c])
            {
                return board[a];
            }
        }
        return null;
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }

    private void RestartGame()
    {
        navigationManager.NavigateTo("/");
    }

    private string GetPlayerClass(PlayerType? player)
    {
        if (!player.HasValue) return "";
        return player == PlayerType.X ? "player-x" : "player-o";
    }
}