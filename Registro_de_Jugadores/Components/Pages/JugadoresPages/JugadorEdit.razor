@page "/jugadores/Edit/{JugadorId:int}"

@inject IJugadoresApiService jugadoresApiService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Editar</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class=" card-header text-center">
            <h5 class="card-title">Editar Jugador</h5>
        </div>
    </div>

    <div class="card-body">


        <div class="mb-3">
            <label class="col-form-label"><strong>Nombres</strong></label>
            <InputText class="form-control" @bind-Value="Nombre"></InputText>
        </div>


        <div class="mb-3">
            <label class="form-label"><strong>Email</strong></label>
            <InputText class="form-control" @bind-Value="Email"></InputText>
        </div>

    </div>

    <div class="card-footer text-center mt-2">
        <a href="/jugadores" class="btn btn-secondary"><span class="bi bi-arrow-left"></span>Volver</a>
        <button type="button" class="btn btn-primary bi bi-floppy" @onclick="Guardar"><span class="bi bi-save>"></span>Guardar</button>

    </div>
</div>



@code {
    [Parameter]
    public int JugadorId{ get; set; }
    public string Nombre { get; set; } = string.Empty;
    public string Email { get; set; } = string.Empty;



    protected override async Task OnInitializedAsync()
    {
        var Response = await jugadoresApiService.GetJugadoresAsync(JugadorId);
        Nombre = Response.Data.Nombres;
        Email = Response.Data.Email;
    }



    public async Task Guardar()
    {

        var ok = await jugadoresApiService.PutJugador(JugadorId,Nombre, Email);

        NavigationManager.NavigateTo("/jugadores");

    }
}
